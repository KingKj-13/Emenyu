# ──────────────────────────────────────────────────
# EMenu Luxury Edition — Backend Configuration
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────────

# PostgreSQL (shared with existing EMenu — same DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/emenyu

# Restaurant identity
RESTAURANT_ID=luxury_trump
RESTAURANT_NAME=Trump Luxury Edition

# JWT / Security
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=https://emenyu.com,http://localhost:5173

# Media
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/luxury/media

# App updates
RELEASES_DIR=./releases
RELEASES_URL_PREFIX=/luxury/releases
