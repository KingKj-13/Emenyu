{
  "name": "emenuy-trump",
  "version": "1.0.0",
  "private": true,
  "description": "Production restaurant SaaS runtime for the Emenyu Trump deployment.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "env:bootstrap": "node scripts/bootstrap-env.js",
    "env:check": "node scripts/validate-env.js",
    "health": "node scripts/healthcheck.js",
    "health:check": "node scripts/health-check.js",
    "diagnostics": "node scripts/diagnostics.js",
    "setup:wizard": "node scripts/setup-wizard.js",
    "menu:import": "node scripts/menu-import.js",
    "qr:generate": "node scripts/qr-generate.js",
    "media:optimize": "node scripts/media-optimize.js",
    "audit:prod": "npm audit --omit=dev",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 reload ecosystem.config.js --only emenuy-trump-api --update-env",
    "pm2:stop": "pm2 stop emenuy-trump-api",
    "pm2:logs": "pm2 logs emenuy-trump-api",
    "auth:migrate": "node scripts/migrate-auth-to-postgres.js",
    "auth:audit": "node scripts/audit-accounts.js",
    "auth:rotate": "node scripts/rotate-weak-accounts.js",
    "reco:seed": "node scripts/seed-chef-recommendations.js",
    "reco:validate": "node scripts/phase3-validate.js",
    "chat:validate": "node scripts/chat-validate.js",
    "reco:health": "node scripts/reco-health.js",
    "reco:health:test": "node scripts/reco-health.js --selftest",
    "reco:verify:live": "node scripts/reco-verify-live.js",
    "reco:validate:phase5": "node scripts/phase5-validate.js",
    "reco:bench": "node scripts/reco-bench.js",
    "smoke:test": "node scripts/smoke-test.js",
    "bundles:seed": "node scripts/seed-bundles.js",
    "menu:migrate": "node scripts/migrate-menu-to-postgres.js",
    "menu:enrich": "node scripts/enrich-menu-tags.js",
    "orders:migrate": "node scripts/migrate-orders-to-postgres.js",
    "orders:seed:demo": "node scripts/seed-demo-orders.js",
    "orders:purge:demo": "node scripts/purge-demo-orders.js",
    "prisma:generate": "npx prisma generate --schema ../../prisma/schema.prisma"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "ws": "8.20.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
