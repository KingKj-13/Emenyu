# Trump's own defaults — checked into git (no secrets, just branding/prefix
# strings). Vite loads this file for every mode/build. A second build for the
# public Demo Steakhouse tenant runs `vite build --mode demo`, which layers
# .env.demo on top of this file. See docs/project-progress/demo-steakhouse-decisions.md.
VITE_BASE_PATH=/Trump
VITE_RESTAURANT_ID=trump
VITE_BRAND_NAME=Trump
VITE_BRAND_TAGLINE=Prime Grillhouse
VITE_HTML_TITLE=Trumps Prime Grillhouse
VITE_HTML_DESCRIPTION=Trumps Prime Grillhouse — Fine Dining Menu
VITE_QR_BASE=https://emenyu.com/Trump
VITE_MAINS_CATEGORY_TITLE=Trumps Premium Steaks
VITE_PASTAS_CATEGORY_TITLE=Trumps Pastas
VITE_DEMO_MODE=false
