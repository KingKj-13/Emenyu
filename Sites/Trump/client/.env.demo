# Public "Demo Steakhouse" tenant overrides. Build with:
#   npx vite build --mode demo --outDir ../../Demo/client/dist
# No restaurant-specific branding here by design (see requirements doc).
VITE_BASE_PATH=/Demo
VITE_RESTAURANT_ID=demo-steakhouse
VITE_BRAND_NAME=Demo Steakhouse
VITE_BRAND_TAGLINE=Premium Steakhouse Experience
VITE_HTML_TITLE=Demo Steakhouse
VITE_HTML_DESCRIPTION=Demo Steakhouse — Premium Dining Experience
VITE_QR_BASE=https://emenyu.com/Demo
VITE_MAINS_CATEGORY_TITLE=Premium Steaks
VITE_PASTAS_CATEGORY_TITLE=Pastas
VITE_DEMO_MODE=true
# Explicitly un-narrow the base .env's VITE_SUPPORTED_LOCALES (Trump's own
# build restricts its language picker) — the sales demo shows all 14.
VITE_SUPPORTED_LOCALES=
