generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  password             String
  role                 String
  label                String?
  suspended            Boolean   @default(false)
  suspendedAt          DateTime?
  sessionInvalidBefore BigInt?
  createdBy            String    @default("system")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([role])
  @@index([suspended])
}

model MenuCategory {
  id           Int            @id @default(autoincrement())
  restaurantId String         @default("trump")
  title        String
  slug         String
  path         String         @unique
  intro        String         @default("")
  parentId     Int?
  parent       MenuCategory?  @relation("MenuCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuCategory[] @relation("MenuCategoryChildren")
  sortOrder    Int            @default(0)
  visible      Boolean        @default(true)
  courseType   String?        @default("MAIN")
  metadata     Json?
  items        MenuItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([restaurantId, parentId, sortOrder])
  @@index([restaurantId, slug])
  @@index([restaurantId, courseType])
  @@index([visible])
}

model MenuItem {
  id             Int          @id @default(autoincrement())
  restaurantId   String       @default("trump")
  categoryId     Int
  category       MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  description    String       @default("")
  story          String       @default("")
  subtitle       String       @default("")
  price          Float        @default(0)
  calories       String       @default("")
  allergens      String       @default("")
  spice          String       @default("")
  imagePath      String       @default("")
  videoPath      String       @default("")
  youtubeId      String       @default("")
  imageVisible   Boolean      @default(true)
  videoVisible   Boolean      @default(true)
  visible        Boolean      @default(true)
  available      Boolean      @default(true)
  // Superset of `available` for tenants that need a third "ask the kitchen"
  // state (e.g. Carmella's Gaspard persona). Trump's admin UI keeps using the
  // boolean; new UIs should read/write this instead.
  availability   String       @default("available")   // available | ask | unavailable
  chefPick       Boolean      @default(false)
  popular        Boolean      @default(false)
  sourceTitle    String       @default("")
  sortOrder      Int          @default(0)
  metadata       Json?
  variants       MenuItemVariant[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([restaurantId, normalizedName])
  @@index([restaurantId, categoryId, sortOrder])
  @@index([visible])
  @@index([available])
  @@index([chefPick])
  @@index([popular])
}

// Carmella: multi-choice items (e.g. "Amy's Choice": Plain / Ham & cheese /
// Extra mushroom addon). isAddon marks a variant as an add-on to the base
// item's price rather than an alternative to it.
model MenuItemVariant {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  itemId       Int
  item         MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name         String
  price        Float    @default(0)
  imagePath    String   @default("")
  isAddon      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, itemId, sortOrder])
}

// Carmella: time-windowed content (greeting, lead chapters, suggestion strip,
// chat chips) that reorders/reskins the menu by time of day. Net-new — Trump
// has no analog today.
model DayPart {
  id            Int      @id @default(autoincrement())
  restaurantId  String   @default("trump")
  slug          String
  name          String
  fromTime      String                    // "HH:MM", restaurant-local time
  toTime        String
  greeting      String   @default("")
  leadChapters  Json?
  gaspardChips  Json?
  suggestStrip  Json?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
}

model FeaturedItem {
  id           Int       @id @default(autoincrement())
  restaurantId String    @default("trump")
  group        String
  itemId       Int?
  itemName     String
  reason       String    @default("")
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId, group, sortOrder])
  @@index([itemId])
  @@index([active])
}

model Recommendation {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  description  String   @default("")
  items        Json
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, active, sortOrder])
}

// Phase 3: per-item, chef-controlled recommendations. Source/target reference
// MenuItem.id (scalar, FK-constrained in SQL). recType + beverageKind drive the
// category-safety layer; priority/active/season/rotationGroup drive ordering and
// rotation; reason is the chef's one-line note shown on the recommendation card.
// Carmella: curatorial item-to-item pairings (carmella-menu-data.json's
// `pairings` map) reuse this model with recType="PAIRING" and `reason` as the
// pairing note — no schema change needed (see ARCHITECTURE_DECISIONS.md AD-002).
model MenuItemRecommendation {
  id            Int       @id @default(autoincrement())
  restaurantId  String    @default("trump")
  sourceItemId  Int
  targetItemId  Int
  recType       String                              // DISH | SIDE | DESSERT | BEVERAGE
  beverageKind  String    @default("NONE")          // WINE | COCKTAIL | BEER | SOFT | HOT | NONE
  priority      Int       @default(100)
  active        Boolean   @default(true)
  season        String    @default("ALL_YEAR")      // ALL_YEAR | SUMMER | WINTER | SPRING | AUTUMN | FESTIVE
  startsAt      DateTime?
  endsAt        DateTime?
  rotationGroup String    @default("")
  reason        String    @default("")
  createdBy     String    @default("system")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([restaurantId, sourceItemId, targetItemId, recType], map: "MenuItemRecommendation_uniq")
  @@index([restaurantId, sourceItemId, active], map: "MenuItemRecommendation_src_idx")
  @@index([restaurantId, rotationGroup], map: "MenuItemRecommendation_rot_idx")
}

model RestaurantMenuSettings {
  id           Int      @id @default(autoincrement())
  restaurantId String   @unique @default("trump")
  settings     Json?
  source       String   @default("json-hybrid")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Table {
  id                Int                @id @default(autoincrement())
  restaurantId      String             @default("trump")
  tableId           String
  displayName       String             @default("")
  status            String             @default("active")
  covers            Int                @default(0)
  metadata          Json?
  orders            Order[]
  cartState         ActiveCartState?
  waiterAssignments WaiterAssignment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([restaurantId, tableId])
  @@index([restaurantId, status])
}

model Order {
  id            Int                  @id @default(autoincrement())
  restaurantId  String               @default("trump")
  filename      String
  tableId       String
  table         Table                @relation(fields: [restaurantId, tableId], references: [restaurantId, tableId])
  status        String               @default("active")
  kitchenStatus String               @default("new")
  waiterName    String               @default("")
  notes         String               @default("")
  subtotal      Float                @default(0)
  vat           Float                @default(0)
  service       Float                @default(0)
  tip           Float                @default(0)
  total         Float                @default(0)
  covers        Int                  @default(0)
  timestamp     DateTime             @default(now())
  sourceKind    String               @default("orders")
  clientOrderId String               @default("")   // Phase 05A — idempotency key (empty = none)
  guestId       Int?
  guest         Guest?               @relation(fields: [guestId], references: [id])
  raw           Json?
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  rating        OrderRating?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([restaurantId, status, timestamp])
  @@index([restaurantId, tableId, status])
  @@index([restaurantId, kitchenStatus])
  @@index([restaurantId, waiterName, status])
  @@index([guestId])
  @@index([timestamp])
  @@index([restaurantId, clientOrderId])
  @@unique([restaurantId, sourceKind, filename])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  price       Float    @default(0)
  quantity    Float    @default(1)
  note        String   @default("")
  imagePath   String   @default("")
  description String   @default("")
  metadata    Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId, sortOrder])
  @@index([name])
}

model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String   @default("")
  toStatus    String
  actor       String   @default("system")
  reason      String   @default("")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([toStatus])
}

model OrderRating {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  orderId      Int      @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String   @default("")
  tableId      String
  createdAt    DateTime @default(now())

  @@index([restaurantId, rating])
  @@index([restaurantId, createdAt])
}

model ActiveCartState {
  id             Int      @id @default(autoincrement())
  restaurantId   String   @default("trump")
  tableId        String
  table          Table    @relation(fields: [restaurantId, tableId], references: [restaurantId, tableId])
  cart           Json
  adminOverrides Json?
  updatedBy      String   @default("system")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([restaurantId, tableId])
  @@index([restaurantId, updatedAt])
}

model WaiterAssignment {
  id             Int       @id @default(autoincrement())
  restaurantId   String    @default("trump")
  tableId        String
  table          Table     @relation(fields: [restaurantId, tableId], references: [restaurantId, tableId])
  waiterName     String
  socketId       String    @default("")
  status         String    @default("active")
  assignedAt     DateTime  @default(now())
  releasedAt     DateTime?
  // Phase 03 — table ownership transfer/takeover/reassign trail. Each ownership
  // change inserts a new row (releasing the prior active one); the rows for a
  // tableId ordered by assignedAt ARE the ownership history.
  changeType     String    @default("assign")   // assign | transfer | takeover | reassign | release
  assignedBy     String    @default("")          // who performed the change (self/manager/system)
  previousWaiter String    @default("")
  reason         String    @default("")
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([restaurantId, tableId, status])
  @@index([restaurantId, tableId, assignedAt])
  @@index([restaurantId, waiterName])
  @@index([socketId])
}

model Guest {
  id            Int       @id @default(autoincrement())
  restaurantId  String    @default("trump")
  name          String
  phone         String    @default("")
  email         String    @default("")
  vip           Boolean   @default(false)
  loyaltyTier   String    @default("")
  dietary       String    @default("")
  allergies     String    @default("")
  preferences   Json?
  notes         String    @default("")
  visitCount    Int       @default(0)
  lifetimeSpend Float     @default(0)
  avgSpend      Float     @default(0)
  lastVisitAt   DateTime?
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([restaurantId, vip])
  @@index([restaurantId, name])
}

model UpsellEvent {
  id            Int      @id @default(autoincrement())
  restaurantId  String   @default("trump")
  waiterName    String   @default("")
  tableId       String   @default("")
  orderId       Int?
  suggestedItem String   @default("")
  accepted      Boolean  @default(false)
  source        String   @default("coach")
  value         Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([restaurantId, waiterName, createdAt])
  @@index([restaurantId, accepted])
}

model WaiterTask {
  id           Int       @id @default(autoincrement())
  restaurantId String    @default("trump")
  tableId      String    @default("")
  waiterName   String    @default("")
  type         String
  title        String
  message      String    @default("")
  priority     Int       @default(3)
  status       String    @default("open")
  payload      Json?
  requestedBy  String    @default("system")
  approvedBy   String    @default("")
  dueAt        DateTime?
  acknowledgedAt DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId, status, priority, createdAt])
  @@index([restaurantId, tableId, status])
  @@index([restaurantId, waiterName, status])
  @@index([type])
}

// Phase 4: recommendation lifecycle analytics. One row per event
// (impression | click | accepted | dismissed | ordered). The recommendation
// engine is name-keyed, so recommendedName is the reliable join key and the
// *ItemId columns are best-effort. Rows are aggregated in-memory over a date
// window (see services/recommendationAnalytics.js) — fine for a single venue's
// volume and keeps the dashboard math identical to the JSON-fallback path.
model RecommendationEvent {
  id                Int      @id @default(autoincrement())
  restaurantId      String   @default("trump")
  eventType         String                              // impression | click | accepted | dismissed | ordered
  source            String   @default("")               // surface or engine source_title (cart, chat, pairing, coach, "Chef's pairing", …)
  recType           String   @default("")               // DISH | SIDE | DESSERT | BEVERAGE | categoryType
  recommendedItemId Int?
  recommendedName   String   @default("")
  originatingItemId Int?
  originatingName   String   @default("")
  rotationGroup     String   @default("")
  sessionId         String   @default("")
  // Device-aware recommendations: which guest device/table this event came
  // from (client/src/services/storage.ts identities), alongside the existing
  // analytics-only sessionId — lets reporting slice by device/table too.
  deviceId          String   @default("")
  tableId           String   @default("")
  mode              String   @default("customer")        // customer | waiter
  chef              Boolean  @default(false)
  value             Float    @default(0)                 // item price — revenue attribution on accepted/ordered
  createdAt         DateTime @default(now())

  @@index([restaurantId, eventType, createdAt])
  @@index([restaurantId, recommendedName])
  @@index([restaurantId, rotationGroup])
  @@index([restaurantId, source])
  @@index([restaurantId, deviceId])
}

// Phase 5: database-backed recommended-order bundles — the menu "Not sure what to
// order?" personas. Replaces the hardcoded client constant (kept only as an offline
// fallback). A bundle groups items by a course label; multiple items may share a course.
model RecommendationBundle {
  id            Int                        @id @default(autoincrement())
  restaurantId  String                     @default("trump")
  slug          String                     @default("")   // stable id used by the client
  persona       String
  description   String                     @default("")
  icon          String                     @default("")
  accent        String                     @default("")
  active        Boolean                    @default(true)
  priority      Int                        @default(100)
  rotationGroup String                     @default("")
  sortOrder     Int                        @default(0)
  // Carmella: a fixed all-in price that may differ from summing item prices
  // (null = fall back to summing items, Trump's current behavior).
  total         Float?
  daypart       String                     @default("")   // "" = all day parts
  items         RecommendationBundleItem[]
  createdBy     String                     @default("system")
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([restaurantId, active, priority])
  @@index([restaurantId, rotationGroup])
  @@index([restaurantId, daypart])
}

model RecommendationBundleItem {
  id        Int                  @id @default(autoincrement())
  bundleId  Int
  bundle    RecommendationBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course    String               @default("")   // Drink | Starter | Main | Dessert | …
  itemName  String
  itemId    Int?
  price     Float                @default(0)
  sortOrder Int                  @default(0)

  @@index([bundleId, sortOrder])
}

model Reservation {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  name         String
  phone        String   @default("")
  partySize    Int      @default(2)
  date         DateTime
  notes        String   @default("")
  status       String   @default("pending")
  tableId      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, date])
  @@index([restaurantId, status])
}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  endpoint     String   @unique
  p256dh       String
  auth         String
  userRole     String   @default("waiter")
  username     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, userRole])
}

// Phase 03 — staff shift lifecycle (operational tracking only; NO payroll/scheduling).
// One ACTIVE shift per username is enforced in shiftService (ended shifts share the
// username, so it is a service-level invariant, not a DB unique). ordersHandled /
// revenueHandled / responseMetrics are recomputed from orders + tasks over the shift
// window on read and snapshotted on end.
model Shift {
  id              Int       @id @default(autoincrement())
  restaurantId    String    @default("trump")
  username        String
  role            String    @default("waiter")
  status          String    @default("active")   // active | ended
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  startedBy       String    @default("")          // self | <manager> | system
  endedBy         String    @default("")
  endReason       String    @default("")
  assignedTables  Json?                            // snapshot of tables owned during the shift
  ordersHandled   Int       @default(0)
  revenueHandled  Float     @default(0)
  responseMetrics Json?                            // { avgResponseSec, callsHandled, tasksResolved }
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([restaurantId, status, startedAt])
  @@index([restaurantId, username, status])
}

// Phase 03 — immutable operational audit trail. Append-only (no updatedAt). Every
// privileged mutation (shift start/end, table reassign/transfer/takeover, account
// create/suspend, notification ack) writes exactly one row via auditService.
model AuditLog {
  id           Int      @id @default(autoincrement())
  restaurantId String   @default("trump")
  actor        String   @default("system")
  actorRole    String   @default("")
  action       String                              // e.g. shift.started | table.reassigned | account.suspended
  targetType   String   @default("")               // table | account | shift | notification | order
  targetId     String   @default("")
  summary      String   @default("")
  reason       String   @default("")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
  @@index([restaurantId, actor])
  @@index([restaurantId, targetType, targetId])
}

// Phase 03 — unified notification center. Sources: customer waiter-calls, reservation
// events, staff reassignment, table transfer, AI warnings, system alerts. read/unread
// is driven by readAt (null = unread). recipientRole "" = all staff; recipientUser ""
// = role-wide.
model Notification {
  id            Int       @id @default(autoincrement())
  restaurantId  String    @default("trump")
  source        String                              // waiter_call | reservation | reassignment | table_transfer | ai_warning | system
  title         String
  body          String    @default("")
  priority      Int       @default(3)               // 1 (urgent) .. 5 (low)
  recipientRole String    @default("")              // "" = all staff | owner | manager | waiter | kitchen
  recipientUser String    @default("")              // "" = role-wide | specific username
  tableId       String    @default("")
  readAt        DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([restaurantId, recipientRole, readAt, createdAt])
  @@index([restaurantId, recipientUser, readAt])
  @@index([restaurantId, source, createdAt])
}

// Phase 04 — native client device + refresh-token registry. One row per logged-in
// device (multiple concurrent devices per user). The refresh token is opaque
// (`<deviceId>.<secret>`); only sha256(secret) is stored. Access tokens stay
// stateless (cookie HMAC format) and are NOT stored here. Revoking a device sets
// revokedAt; rotation on each refresh replaces refreshTokenHash.
model Device {
  id               Int       @id @default(autoincrement())
  restaurantId     String    @default("trump")
  deviceId         String    @unique
  username         String
  deviceName       String    @default("")
  platform         String    @default("")      // android | ios | desktop | web
  refreshTokenHash String
  refreshExpiresAt DateTime
  pushToken        String    @default("")        // Phase 04B — Expo/FCM push token (empty = no push)
  pushProvider     String    @default("")        // expo | fcm | apns | webpush
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([username, revokedAt])
  @@index([restaurantId, username])
}

// Curated Demo Mode — one-time-redemption "make-good" reward QR (Order
// Complete flow: a guest who declined most curated recommendations gets
// "your next drink is on us" instead of a thank-you). Same shape as
// Device.refreshTokenHash above: only a hash of the signed secret is stored,
// never the secret itself — redemption is a single atomic conditional
// update (status: 'issued' -> 'redeemed'), which is what makes it provably
// one-time-use even under a concurrent double-scan (see rewardService.js).
model RewardCode {
  id           Int       @id @default(autoincrement())
  restaurantId String    @default("trump")
  tableId      String    @default("")
  deviceId     String    @default("")
  codeHash     String    @unique
  status       String    @default("issued") // issued | redeemed | expired | revoked
  reason       String    @default("")       // e.g. "declined-recommendations"
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  redeemedAt   DateTime?
  redeemedBy   String    @default("")       // staff username who redeemed it

  @@index([restaurantId, deviceId])
  @@index([restaurantId, status])
}

// AI Shared Event System — the single structured record for anything the
// deterministic AI layer (chat-text pattern detection, guest-seating, order
// composition) notices, so admin/waiter/analytics all read the same row
// instead of each surface re-deriving its own interpretation. See
// server/services/aiEventService.js for the event taxonomy and detection
// rules; a linked WaiterTask (waiterTaskId) keeps the existing waiter
// task-inbox UI working unchanged — this table is additive, not a
// replacement for WaiterTask.
model AiEvent {
  id                     Int       @id @default(autoincrement())
  restaurantId           String    @default("trump")
  eventType              String    // birthday | anniversary | vip | returning_guest | high_value |
                                    // wine_recommendation | upsell_opportunity | dietary_restriction | allergy |
                                    // business_meeting | date_night | proposal | promotion_celebration |
                                    // family_dinner | large_group | milestone
  guestId                Int?
  tableId                String    @default("")
  waiterName             String    @default("")
  priority               Int       @default(3)   // 1=urgent .. 3=low, same convention as WaiterTask.priority
  confidence             Float     @default(1)   // 0..1 — deterministic rules, not ML; see aiEventService for how each type sets this
  recommendedAction      String    @default("")
  suggestedWaiterMessage String    @default("")
  suggestedManagerAction String    @default("")
  status                 String    @default("open") // open | acknowledged | resolved | dismissed
  source                 String    @default("system") // chat | guest_seated | order_placed | system
  payload                Json?
  waiterTaskId           Int?
  createdAt              DateTime  @default(now())
  acknowledgedAt         DateTime?
  resolvedAt             DateTime?

  @@index([restaurantId, status, priority, createdAt])
  @@index([restaurantId, tableId, status])
  @@index([restaurantId, eventType])
  @@index([restaurantId, guestId])
}
