# Claude Code settings (contains SSH keys, server IPs, deployment history)
.claude/

# Environment and secrets
.env
.env.*
!.env.example
# Client build-time branding config (no secrets — just prefix/brand strings
# Vite needs at build time for the Trump vs. Demo Steakhouse builds).
!Sites/Trump/client/.env
!Sites/Trump/client/.env.demo
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
certs/
private/
dont_upload/

# Dependencies and generated clients
node_modules/
*/node_modules/
venv/
*/venv/
__pycache__/
*.pyc
/generated/prisma/

# Runtime data and local-only state
logs/
*/logs/
backups/
*/backups/
sessions/
*/sessions/
temp/
*/temp/
tmp/
*/tmp/
cache/
*/cache/
.cache/
*/.cache/
uploads/
*/uploads/
orders/
*/orders/
history/
*/history/
tables/
*/tables/

# Databases, dumps, and account/session material
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
# …but Prisma migration SQL must always be tracked (it's the deploy source of truth).
!prisma/migrations/**/*.sql
*.bak
*.backup
*accounts.json
*chat_logs.json
*brain_memory.json
*menu_embeddings.pkl

# Full-resolution image originals (~3GB) kept by scripts/optimize-images-oneoff.js,
# and the generated thumbnail set — media ships to the box via rsync/tar, not git.
Sites/Trump/Images/_originals/
Sites/Trump/Images/thumbnails/

# Video files (too large for GitHub)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
Video/
*/Video/

# Logs, archives, and validation artifacts
*.log
*.tmp
*.tar
*.tar.gz
*.zip
*.7z
*.rar
validation-*.png
*/validation-*.png
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2*.log

# Luxury Edition — local-only backup snapshot, not canonical source
luxury/flutter_backup/
